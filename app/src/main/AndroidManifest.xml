<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet permission for Gemini AI -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RestaurantApp"
        tools:targetApi="31">

        <!-- Activity khởi động app -->
        <activity
            android:name=".authentication.LoginActivity"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- Authentication -->
        <activity
            android:name=".authentication.RegisterActivity"
            android:exported="false" />
        <activity 
            android:name=".authentication.RegisterStaffActivity"
            android:exported="false" />
        
        <!-- Main Activities -->
        <activity android:name=".MainActivity"/>
        <activity android:name=".AdminActivity"/>
        <activity android:name=".StaffActivity"/>
        <activity android:name=".CustomerActivity"/>
        
        <!-- Other Activities -->
        <activity 
            android:name=".activities.OrderHistoryActivity"
            android:exported="false" />

    </application>

</manifest>
