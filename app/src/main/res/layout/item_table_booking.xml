<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:padding="16dp"
    android:background="@drawable/bg_card_elevated">

    <!-- Table Icon -->
    <ImageView
        android:id="@+id/ivTableIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_table"
        android:padding="8dp"
        android:background="@drawable/bg_status_free"
        app:tint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Table Name -->
    <TextView
        android:id="@+id/tvTableName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Bàn 1"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintStart_toEndOf="@id/ivTableIcon"
        app:layout_constraintTop_toTopOf="@id/ivTableIcon"
        app:layout_constraintEnd_toStartOf="@id/tvCapacity" />

    <!-- Capacity -->
    <TextView
        android:id="@+id/tvCapacity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="4 người"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:drawablePadding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivTableIcon" />

    <!-- Status -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Trống"
        android:textSize="13sp"
        android:textColor="@color/status_free"
        app:layout_constraintStart_toEndOf="@id/ivTableIcon"
        app:layout_constraintTop_toBottomOf="@id/tvTableName"
        app:layout_constraintBottom_toBottomOf="@id/ivTableIcon" />

    <!-- Book Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBook"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Đặt bàn"
        android:textColor="@color/white"
        app:backgroundTint="@color/primary"
        app:cornerRadius="8dp"
        app:layout_constraintTop_toBottomOf="@id/ivTableIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
