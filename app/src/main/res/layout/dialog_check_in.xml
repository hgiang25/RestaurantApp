<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chấm công"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#1A2B4C"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chọn ca làm việc:"
        android:textColor="#666666"
        android:layout_marginBottom="8dp"/>

    <RadioGroup
        android:id="@+id/radioGroupShift"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/radioMorning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ca sáng (6:00 - 14:00)"
            android:padding="8dp"/>

        <RadioButton
            android:id="@+id/radioAfternoon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ca chiều (14:00 - 22:00)"
            android:padding="8dp"/>

        <RadioButton
            android:id="@+id/radioEvening"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ca tối (22:00 - 6:00)"
            android:padding="8dp"/>

    </RadioGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginVertical="16dp"/>

    <TextView
        android:id="@+id/tvCurrentTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#007BFF"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckIn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Check In"
            android:layout_marginEnd="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckOut"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Check Out"
            android:layout_marginStart="8dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

    </LinearLayout>

</LinearLayout>
