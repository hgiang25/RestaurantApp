<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:padding="16dp"
    android:background="@drawable/bg_card_elevated">

    <!-- Status Indicator -->
    <View
        android:id="@+id/statusIndicator"
        android:layout_width="4dp"
        android:layout_height="0dp"
        android:background="@color/primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/tvNote" />

    <!-- Table Name -->
    <TextView
        android:id="@+id/tvTableName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Bàn 1"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintStart_toEndOf="@id/statusIndicator"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tvStatus" />

    <!-- Status Badge -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chờ xác nhận"
        android:textSize="12sp"
        android:textColor="@color/white"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:background="@drawable/bg_status_pending"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Date & Time -->
    <TextView
        android:id="@+id/tvDateTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:text="📅 25/12/2024 - 18:00"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        app:layout_constraintStart_toEndOf="@id/statusIndicator"
        app:layout_constraintTop_toBottomOf="@id/tvTableName"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Guests -->
    <TextView
        android:id="@+id/tvGuests"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:text="👥 4 khách"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        app:layout_constraintStart_toEndOf="@id/statusIndicator"
        app:layout_constraintTop_toBottomOf="@id/tvDateTime"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Note -->
    <TextView
        android:id="@+id/tvNote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:text="📝 Ghi chú..."
        android:textSize="13sp"
        android:textColor="@color/text_hint"
        android:maxLines="2"
        android:ellipsize="end"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@id/statusIndicator"
        app:layout_constraintTop_toBottomOf="@id/tvGuests"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Hủy đặt"
        android:textColor="@color/error"
        app:strokeColor="@color/error"
        app:cornerRadius="8dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/tvTableName"
        app:layout_constraintTop_toBottomOf="@id/tvNote" />

</androidx.constraintlayout.widget.ConstraintLayout>
