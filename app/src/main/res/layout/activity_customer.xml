<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="56dp" />

    <!-- FAB Chat Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="110dp"
        android:contentDescription="Trợ lý AI"
        app:srcCompat="@drawable/ic_chat_bot"
        app:fabSize="normal"
        app:backgroundTint="@color/primary"
        app:tint="@color/white"
        app:elevation="8dp"/>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="16dp"
        app:itemActiveIndicatorStyle="@style/Widget.App.BottomNav.ActiveIndicator"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemRippleColor="@color/primary_surface"
        app:itemTextAppearanceActive="@style/Widget.App.BottomNav.Text"
        app:itemTextAppearanceInactive="@style/Widget.App.BottomNav.Text"
        app:itemTextColor="@color/bottom_nav_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_customer_bottom_nav" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>