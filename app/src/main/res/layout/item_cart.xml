<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:layout_marginVertical="4dp">

    <!-- Item Image Placeholder -->
    <View
        android:id="@+id/itemImageBg"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/bg_input_field"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivItemIcon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_menu_food"
        app:tint="@color/primary"
        app:layout_constraintStart_toStartOf="@id/itemImageBg"
        app:layout_constraintEnd_toEndOf="@id/itemImageBg"
        app:layout_constraintTop_toTopOf="@id/itemImageBg"
        app:layout_constraintBottom_toBottomOf="@id/itemImageBg" />

    <!-- Item Name -->
    <TextView
        android:id="@+id/tvItemName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Phở bò"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/itemImageBg"
        app:layout_constraintEnd_toStartOf="@id/btnRemove"
        app:layout_constraintTop_toTopOf="@id/itemImageBg" />

    <!-- Unit Price -->
    <TextView
        android:id="@+id/tvUnitPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="50,000đ"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        app:layout_constraintStart_toEndOf="@id/itemImageBg"
        app:layout_constraintBottom_toBottomOf="@id/itemImageBg" />

    <!-- Remove Button -->
    <ImageButton
        android:id="@+id/btnRemove"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Xóa"
        app:tint="@color/text_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Quantity Controls -->
    <LinearLayout
        android:id="@+id/layoutQuantity"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="4dp"
        app:layout_constraintStart_toEndOf="@id/itemImageBg"
        app:layout_constraintTop_toBottomOf="@id/itemImageBg"
        android:layout_marginStart="12dp">

        <ImageButton
            android:id="@+id/btnMinus"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_minus"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Giảm"
            app:tint="@color/primary" />

        <TextView
            android:id="@+id/tvQuantity"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="2"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center" />

        <ImageButton
            android:id="@+id/btnPlus"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_plus"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Tăng"
            app:tint="@color/primary" />

    </LinearLayout>

    <!-- Item Total -->
    <TextView
        android:id="@+id/tvItemTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="100,000đ"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/layoutQuantity"
        app:layout_constraintBottom_toBottomOf="@id/layoutQuantity" />

</androidx.constraintlayout.widget.ConstraintLayout>
